{
	"name": "mcs-syntax",
	"displayName": "MCS Syntax",
	"description": "Melon classificator script syntax support for VS Code based IDE.",
	"version": "0.1.1",
	"publisher": "dub1401",
	"repository": {
		"type": "git",
		"url": "https://github.com/otaku-melons/mcs-syntax"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"contributes": {
		"languages": [
			{
				"id": "mcs",
				"extensions": [
					".mcs"
				]
			}
		],
		"grammars": [
			{
				"language": "mcs",
				"scopeName": "source.mcs",
				"path": "./syntaxes/mcs.tmLanguage.json"
			}
		]
	}
}